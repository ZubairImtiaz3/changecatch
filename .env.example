# ChangeCatch configuration. Copy to .env at the repo root (never commit .env).
# Empty = use the default shown in the comment. Durations are milliseconds. Full reference: docs/configuration.md
# A = API server, W = worker, T = tools.

# --- HubSpot app credentials (required) ---------------------------------------------------------------
# App client ID / secret from the HubSpot developer project (A, W, T).
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Numeric app ID (the number at the end of the app's URL in HubSpot). After install, users are sent to the
# ChangeCatch settings tab in HubSpot. Unset = a plain "installed" page (A).
HUBSPOT_APP_ID=
# OAuth redirect URI exactly as registered; its path is the callback route, its port the API port (A).
HUBSPOT_REDIRECT_URI=http://localhost:3001/oauth/callback
# Space-separated scopes for the app-level journal token (W, T). Default: the 3 developer.webhooks_journal.* scopes.
HUBSPOT_JOURNAL_SCOPES=

# --- Security --------------------------------------------------------------------------------------------
# Refresh-token encryption keys, "id:base64key,..." (32 bytes each); FIRST is active (A, W, T). Required.
# Generate: node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEYS=
# Legacy single key; only while old "v1:" ciphertexts exist (A, W, T).
TOKEN_ENC_KEY=
# x-health-token value that unlocks per-portal detail on /health and /metrics (W). Unset = never shown.
HEALTH_TOKEN=
# 1 = skip settings-page signature checks. Local testing only; refused in production / non-localhost (A).
SETTINGS_ALLOW_UNSIGNED=
# production = enable production safety checks (A, W).
NODE_ENV=

# --- API server ------------------------------------------------------------------------------------------
# Listen port (A). Default: the port of HUBSPOT_REDIRECT_URI.
PORT=
# Public https origin HubSpot calls for the settings page; required when NODE_ENV=production (A).
PUBLIC_BASE_URL=
# Watched pairs for a new install, "from:to,..." (A). Default 0-3:0-1,0-3:0-2,0-2:0-1.
CHANGECATCH_DEFAULT_PAIRS=
# conditional (default) | optional: how custom-object write scopes are requested (A).
CUSTOM_WRITE_MODE=conditional
# How often the APP_LIFECYCLE_EVENT journal subscriptions are checked (A). Default 600000.
LIFECYCLE_SUB_CHECK_MS=

# --- Storage ---------------------------------------------------------------------------------------------
# SQLite file shared by API and worker; relative paths are relative to service/ (A, W, T). Default data/changecatch.db.
DB_PATH=
# Pruning + PRAGMA optimize interval, 0 = off (A, W). Default 600000.
DB_MAINTENANCE_INTERVAL_MS=
# WAL auto-checkpoint pages, 0 = external replicator only (A, W). Default 1000.
SQLITE_WAL_AUTOCHECKPOINT=

# --- Worker: journal reading -----------------------------------------------------------------------------
JOURNAL_POLL_MS=                # interval between reads. Default 3000
JOURNAL_IDLE_MAX_MS=            # idle back-off cap. Default = JOURNAL_POLL_MS (no back-off)
JOURNAL_ERROR_BASE_MS=          # first back-off after a failed read. Default 5000
JOURNAL_ERROR_MAX_MS=           # failed-read back-off cap. Default 120000
JOURNAL_BATCH_SIZE=             # entries per batch read, 1-100. Default 100
JOURNAL_DOWNLOAD_CONCURRENCY=   # parallel journal file downloads. Default 16
JOURNAL_MAX_FILE_BYTES=         # size cap per journal file. Default 20971520
JOURNAL_DOWNLOAD_TIMEOUT_MS=    # download timeout per file. Default 15000
JOURNAL_SKIP_FAILED_AFTER_MS=   # skip an entry that keeps failing (207) after this. Default 1800000
JOURNAL_OFFSET_MAX_AGE_MS=      # empty read + offset older than this -> check earliest (expired offsets can read EMPTY, not 404); /health degraded. Default 172800000 (48 h)

# --- Worker: pairing and labels --------------------------------------------------------------------------
PAIRING_WINDOW_MS=              # REMOVED+ADDED within this = one LABEL_CHANGED. Default 2000
PAIRING_PUBLISH_SLACK_MS=       # extra wait for HubSpot's publish delay. Default 4000
PAIRING_MAX_HOLD_MS=            # safety cap on holding an unpaired cluster. Default 60000
PAIRING_SPLIT_HOLD_MS=          # hold for a possible split action, 0 = off. Default 4000
LABEL_MAX_HOLD_MS=              # give up on an unresolvable label after this. Default 1800000
PARK_MAX_PER_PORTAL=            # max parked entries per portal. Default 20000

# --- Worker: stamping ------------------------------------------------------------------------------------
STAMP_SPACING_MS=               # min gap between stamps on one record (no settings row). Default 3000
STAMP_MIRROR=                   # 1 = also stamp the record on the other side
COALESCE_MODE=                  # latest (default) | off
COALESCE_THRESHOLD=             # pending changes per record before coalescing, >= 2. Default 3
STAMP_PORTAL_CONCURRENCY=       # portals stamped in parallel per drain. Default 8
STAMP_RETRY_MAX_MS=             # retry transient stamp failures this long. Default 86400000
PORTAL_PAUSE_MAX_MS=            # purge a revoked portal after this. Default 604800000

# --- Worker: lifecycle and process -----------------------------------------------------------------------
LIFECYCLE_RETRY_BASE_MS=        # first retry for a failed install/uninstall step. Default 30000
LIFECYCLE_RETRY_MAX_MS=         # lifecycle retry cap. Default 1800000
LIFECYCLE_INSTALL_GRACE_MS=     # grace while the API provisions a new install. Default 300000
WORKER_LOCK_STALE_MS=           # single-worker lock staleness. Default 30000
WORKER_HEALTH_PORT=             # /health and /metrics port (W, T). Default 3002
WORKER_VERBOSE=                 # 1 = log every journal read

# --- HTTP and rate limits --------------------------------------------------------------------------------
HS_PORTAL_RATE_PER_10S=         # requests per 10 s per portal (HubSpot allows 110). Default 100
HS_PORTAL_MAX_WAIT_MS=          # defer a call that would wait longer for the limiter. Default 10000
HTTP_TIMEOUT_MS=                # timeout per HTTP attempt. Default 20000

# --- Logging, errors, monitoring -------------------------------------------------------------------------
LOG_LEVEL=                      # debug | info (default) | warn | error
LOG_FORMAT=                     # json (default) | pretty
HEARTBEAT_URL=                  # dead-man's-switch URL pinged after successful reads (W). Unset = off
SENTRY_DSN=                     # enables Sentry (needs @sentry/node). Unset = log only
SENTRY_ENVIRONMENT=             # default NODE_ENV, else production
SENTRY_RELEASE=                 # e.g. git SHA
SENTRY_TRACES_SAMPLE_RATE=      # default 0 (errors only)

# --- Tools only (development; never set in production) ---------------------------------------------------
HUBSPOT_TEST_PORTAL_ID=         # default portal for tools (T)
HUBSPOT_TEST_REFRESH_TOKEN=     # dev fallback token for that portal (T)
HUBSPOT_SETUP_TOKEN=            # service key with write scopes for test-data / load-test tools (T)
CHANGECATCH_TEST_LABELS=        # label names the e2e / load tools use (T)
SAMPLES_DIR=                    # JSON report folder. Default tools/samples (T)
