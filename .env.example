# ChangeCatch configuration. Copy to .env at the repo root (never commit .env).
# Empty = use the default shown in the comment. Durations are milliseconds. Full reference: docs/configuration.md
# A = API server, W = worker, T = tools. A bad value stops the process at start with a clear error.

# --- HubSpot app credentials (required) ---------------------------------------------------------------
# App client ID / secret from the HubSpot developer project (A, W, T).
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Numeric app ID (the number at the end of the app's URL in HubSpot). After install, users are sent to the
# ChangeCatch settings tab in HubSpot. Unset = a plain "installed" page (A).
HUBSPOT_APP_ID=
# OAuth redirect URI exactly as registered; its path is the callback route, its port the API port (A). Required.
HUBSPOT_REDIRECT_URI=http://localhost:3001/oauth/callback

# --- Security --------------------------------------------------------------------------------------------
# Refresh-token encryption keys, "id:base64key,..." (32 bytes each); FIRST is active (A, W, T). Required.
# Generate: node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEYS=
# x-health-token value that unlocks per-portal detail on /health and /metrics (W, T). Unset = never shown.
HEALTH_TOKEN=
# 1 = skip settings-page signature checks. Local testing only; refused in production / non-localhost (A).
SETTINGS_ALLOW_UNSIGNED=
# production = enable production safety checks (A, W).
NODE_ENV=

# --- API server ------------------------------------------------------------------------------------------
# Listen port (A). Default: the port of HUBSPOT_REDIRECT_URI.
PORT=
# Public https origin HubSpot calls for the settings page; required when NODE_ENV=production (A).
PUBLIC_BASE_URL=

# --- Storage ---------------------------------------------------------------------------------------------
# SQLite file shared by API, worker and tools; relative paths are relative to service/ (A, W, T). Default data/changecatch.db.
DB_PATH=

# --- Worker ----------------------------------------------------------------------------------------------
HS_PORTAL_RATE_PER_10S=         # requests per 10 s per account, incident lever (HubSpot allows 110). Default 100
JOURNAL_POLL_MS=                # interval between journal reads. Default 3000
PAIRING_WINDOW_MS=              # REMOVED+ADDED within this = one LABEL_CHANGED (incident override). Default 2000
PAIRING_SPLIT_HOLD_MS=          # hold for a possible split action, 0 = off (incident override). Default 4000
STAMP_MIRROR=                   # 1 = also stamp the record on the other side. Default 0
STAMP_RETRY_MAX_MS=             # retry failing stamps this long before dead-lettering (incident lever). Default 86400000
WORKER_HEALTH_PORT=             # /health and /metrics port (W, T). Default 3002

# --- Logging and monitoring ------------------------------------------------------------------------------
LOG_LEVEL=                      # debug | info (default) | warn | error
LOG_FORMAT=                     # json (default) | pretty
HEARTBEAT_URL=                  # dead-man's-switch URL pinged after successful reads (W). Unset = off

# --- Tools only (development; never set in production) ---------------------------------------------------
HUBSPOT_TEST_PORTAL_ID=         # default portal for tools (T)
HUBSPOT_SETUP_TOKEN=            # service key with write scopes for the load-test / e2e tools (T)
CHANGECATCH_TEST_LABELS=        # label names the e2e / load tools use (T)
SAMPLES_DIR=                    # JSON report folder. Default tools/samples (T)
