# Normalize all text files to LF in the repo and on checkout (stops CRLF warnings on Windows).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.db    binary
*.sqlite binary

# Lockfile: treat as generated in diffs.
pnpm-lock.yaml -diff linguist-generated=true
